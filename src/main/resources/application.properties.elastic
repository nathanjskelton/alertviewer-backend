server.port=8085
logging.level.dts=DEBUG
spring.data.mongodb.database=LogViewer
files.path=/opt/log_index
ingest.fixedrate=30000
ingester.type=elastic
kibana.url=http://localhost:5601/app/kibana/#/discover?_g=(refreshInterval:(pause:!t,value:0),time:(from:now-1M,to:now))&_a=(columns:!(_source),filters:!((%27$state%27:(store:appState),meta:(alias:!n,disabled:!f,key:__field__,negate:!f,params:(query:__value__),type:phrase,value:__value__),query:(match:(__field__:(query:__value__,type:phrase))))),interval:auto,sort:!(%27@timestamp%27,desc))
management.endpoints.web.exposure.include=prometheus
elastic.url=http://localhost:9200/_search?size=10000
elastic.timeformat=yyyy-MM-dd'T'HH:mm:ss.SSS
initial.days.ago=5

elastic.entry.startDelim=\ 
elastic.entry.startDelimCount=2
elastic.entry.endDelim=\t
elastic.entry.msgfield=message
elastic.timestamp.field=@timestamp

spring.profiles.active=dev

server.ssl.key-store-type=JKS
server.ssl.key-store=/opt/certs/keystore.jks
server.ssl.key-store-password=p_ssword1
server.ssl.key-alias=tomcat

security.require-ssl=true
login.username=user
login.password=p_ssword1

elastic.user=foo
elastic.password=bar
